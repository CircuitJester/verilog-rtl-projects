digraph "binary_counter_4bit" {
label="binary_counter_4bit";
rankdir="LR";
remincross=true;
n2 [ shape=octagon, label="clk", color="black", fontcolor="black" ];
n3 [ shape=octagon, label="q", color="black", fontcolor="black" ];
n4 [ shape=octagon, label="rst", color="black", fontcolor="black" ];
v0 [ label="1'1" ];
c8 [ shape=record, label="{{<p5> A|<p6> B}|$2\n$add|{<p7> Y}}",  ];
c13 [ shape=record, label="{{<p9> ARST|<p10> CLK|<p11> D}|$3\n$adff|{<p12> Q}}",  ];
c8:p7:e -> c13:p11:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n2:e -> c13:p10:w [color="black", fontcolor="black", label=""];
c13:p12:e -> n3:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n3:e -> c8:p5:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n4:e -> c13:p9:w [color="black", fontcolor="black", label=""];
v0:e -> c8:p6:w [color="black", fontcolor="black", label=""];
}
